<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ====== PALETTE CLAIRE ====== -->
    <Color x:Key="BgColor">#FFF4F6FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFBFCFE</Color>
    <Color x:Key="SurfaceHoverColor">#FFEEF2F8</Color>
    <Color x:Key="BorderColor">#FFDDE3EC</Color>
    <Color x:Key="BorderStrongColor">#FFBAC5D5</Color>
    <Color x:Key="AccentColor">#FF2572D6</Color>
    <Color x:Key="AccentSoftColor">#332572D6</Color>
    <Color x:Key="AccentGreenColor">#FF0FA673</Color>
    <Color x:Key="AccentOrangeColor">#FFDE6E16</Color>
    <Color x:Key="TextPrimaryColor">#FF0F1724</Color>
    <Color x:Key="TextSecondaryColor">#FF3F5169</Color>
    <Color x:Key="TextMutedColor">#FF6B7A91</Color>
    <Color x:Key="DangerColor">#FFCC3A3A</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Bouton primaire : texte foncé sur accent pour contraste -->
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFFFF" />

    <!-- Typographie (identique) -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="UiFontMono">Cascadia Mono, Consolas, monospace</FontFamily>
    <sys:Double x:Key="FontSizeLarge">20</sys:Double>
    <sys:Double x:Key="FontSizeHeading">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">11.5</sys:Double>

    <!-- Inclure la fiche de styles partagée : styles communs à Dark / Light -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/WindowGrabber;component/Themes/SharedStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>

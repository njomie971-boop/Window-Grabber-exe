<Window x:Class="WindowGrabber.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowGrabber.Views"
        xmlns:vm="clr-namespace:WindowGrabber.ViewModels"
        xmlns:conv="clr-namespace:WindowGrabber.Converters"
        mc:Ignorable="d"
        Title="Window Grabber"
        Width="1280" Height="800"
        MinWidth="860" MinHeight="560"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ConnectionToTextConverter x:Key="ConnToText" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + titre -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/logo.png"
                           Width="52" Height="52" Margin="0,0,16,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Window Grabber"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="By Super Bokit"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0" />
                        <TextBlock Text="Ramène n'importe quelle fenêtre sur l'écran où vous êtes"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Indicateur moniteur cible -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="16,10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{Binding TargetMonitorBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding TargetMonitorBrush, Mode=OneWay}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Moniteur cible · " Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Run Text="{Binding TargetMonitorLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Run Text="   " />
                            <Run Text="{Binding TargetMonitorDetails, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Actualiser"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" />
                    <Button Content="Paramètres"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== SUBHEADER: moniteurs + recherche ========== -->
        <Grid Grid.Row="1" Margin="20,14,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pills moniteurs -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Monitors}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,6"
                                Padding="12,6"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="Moniteur " />
                                    <Run Text="{Binding Index, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="·" Margin="8,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding Width, Mode=OneWay}" />
                                    <Run Text="×" />
                                    <Run Text="{Binding Height, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="·" Margin="8,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding Connection, Mode=OneWay, Converter={StaticResource ConnToText}}" />
                                <Border Margin="10,0,0,0"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="999"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsPrimary, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="principal"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="{StaticResource FontSizeSmall}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Tri -->
            <ComboBox Grid.Column="1"
                      Width="170"
                      SelectedIndex="{Binding SortMode}"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Trier par moniteur" />
                <ComboBoxItem Content="Trier par titre" />
                <ComboBoxItem Content="Trier par application" />
            </ComboBox>

            <!-- Recherche avec loupe + placeholder -->
            <Grid Grid.Column="2" Width="280" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="34,8,10,8" />
                <!-- Loupe SVG -->
                <Path Data="M7,2 C9.76,2 12,4.24 12,7 C12,8.22 11.56,9.34 10.83,10.21 L14.5,13.88 L13.88,14.5 L10.21,10.83 C9.34,11.56 8.22,12 7,12 C4.24,12 2,9.76 2,7 C2,4.24 4.24,2 7,2 Z M7,3.5 C5.07,3.5 3.5,5.07 3.5,7 C3.5,8.93 5.07,10.5 7,10.5 C8.93,10.5 10.5,8.93 10.5,7 C10.5,5.07 8.93,3.5 7,3.5 Z"
                      Fill="{DynamicResource TextSecondaryBrush}"
                      Width="16" Height="16"
                      Stretch="Uniform"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      IsHitTestVisible="False" />
                <!-- Placeholder -->
                <TextBlock Text="Rechercher une fenêtre…"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Margin="36,0,0,0"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ========== GRILLE DE CARTES ========== -->
        <Grid Grid.Row="2" Margin="20,10,20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding WindowsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:WindowCard Width="290" Height="210"
                                              Margin="0,0,14,14"
                                              x:Name="Card"
                                              DataContext="{Binding}"
                                              CardClicked="Card_CardClicked"
                                              LiveThumbnails="{Binding DataContext.Settings.LiveThumbnailsEnabled,
                                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding WindowsView.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Aucune fenêtre détectée"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Ouvrez des applications ou essayez d'actualiser."
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ========== FOOTER ========== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding WindowCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" fenêtre(s)" />
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2"
                           Text="Astuce : cliquez sur une carte pour ramener la fenêtre"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}" />
            </Grid>
        </Border>
    </Grid>
</Window>
       <Run Text="{Binding WindowCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" fenêtre(s)" />
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2"
                           Text="Astuce : cliquez sur une carte pour ramener la fenêtre"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}" />
            </Grid>
        </Border>
    </Grid>
</Window>

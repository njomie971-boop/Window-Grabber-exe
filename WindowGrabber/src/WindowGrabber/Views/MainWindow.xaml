<Window x:Class="WindowGrabber.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WindowGrabber.Views"
        xmlns:vm="clr-namespace:WindowGrabber.ViewModels"
        xmlns:conv="clr-namespace:WindowGrabber.Converters"
        mc:Ignorable="d"
        Title="Window Grabber"
        Width="1280" Height="800"
        MinWidth="860" MinHeight="560"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:ConnectionToTextConverter x:Key="ConnToText" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + titre -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Resources/logo.png"
                           Width="36" Height="36" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Window Grabber"
                                   FontSize="{StaticResource FontSizeLarge}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Ramène n'importe quelle fenêtre sur l'écran où vous êtes"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Indicateur moniteur cible -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="16,10"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Moniteur cible · " Foreground="{StaticResource TextSecondaryBrush}" />
                            <Run Text="{Binding TargetMonitorLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="   " />
                            <Run Text="{Binding TargetMonitorDetails}" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Actualiser"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,10,0" />
                    <Button Content="Paramètres"
                            Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource GhostButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== SUBHEADER: moniteurs + recherche ========== -->
        <Grid Grid.Row="1" Margin="20,14,20,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Pills moniteurs -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Monitors}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,6"
                                Padding="12,6"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <Run Text="Moniteur " />
                                    <Run Text="{Binding Index}" />
                                </TextBlock>
                                <TextBlock Text="·" Margin="8,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding Width, Mode=OneWay}" />
                                    <Run Text="×" />
                                    <Run Text="{Binding Height, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="·" Margin="8,0"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding Connection, Converter={StaticResource ConnToText}}" />
                                <Border Margin="10,0,0,0"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="999"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="principal"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="{StaticResource FontSizeSmall}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Tri -->
            <ComboBox Grid.Column="1"
                      Width="170"
                      SelectedIndex="{Binding SortMode}"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center">
                <ComboBoxItem Content="Trier par moniteur" />
                <ComboBoxItem Content="Trier par titre" />
                <ComboBoxItem Content="Trier par application" />
            </ComboBox>

            <!-- Recherche -->
            <TextBox Grid.Column="2"
                     Width="260"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center"
                     Tag="Rechercher une fenêtre…" />
        </Grid>

        <!-- ========== GRILLE DE CARTES ========== -->
        <Grid Grid.Row="2" Margin="20,10,20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding WindowsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:WindowCard Width="290" Height="210"
                                              Margin="0,0,14,14"
                                              x:Name="Card"
                                              DataContext="{Binding}"
                                              CardClicked="Card_CardClicked"
                                              LiveThumbnails="{Binding DataContext.Settings.LiveThumbnailsEnabled,
                                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding WindowsView.IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Aucune fenêtre détectée"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Ouvrez des applications ou essayez d'actualiser."
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ========== FOOTER ========== -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding WindowCount}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" fenêtre(s)" />
                </TextBlock>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="2"
                           Text="Astuce : cliquez sur une carte pour ramener la fenêtre"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeSmall}" />
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="WindowGrabber.Views.WindowCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:WindowGrabber.Controls"
             xmlns:conv="clr-namespace:WindowGrabber.Converters"
             mc:Ignorable="d"
             d:DesignWidth="280" d:DesignHeight="200">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Border x:Name="Root"
            Cursor="Hand"
            Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1"
            MouseLeftButtonUp="Root_OnMouseLeftButtonUp">
        <!-- Border change selon IsOnTargetMonitor -->
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOnTargetMonitor, Mode=OneWay}" Value="True">
                        <Setter Property="BorderBrush" Value="{Binding MonitorBrush, Mode=OneWay}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Bande de couleur du moniteur -->
            <Border Grid.Column="0"
                    Background="{Binding MonitorBrush, Mode=OneWay}"
                    CornerRadius="12,0,0,12"
                    Margin="-14,-14,0,-14" />

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Zone miniature : fallback toujours visible, DWM peint par-dessus si succès -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="110"
                        ClipToBounds="True">
                    <Grid>
                        <Grid x:Name="Fallback">
                            <Image Source="{Binding Icon, Mode=OneWay}"
                                   Width="56" Height="56"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="■" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="36" Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        </Grid>

                        <ctrl:DwmThumbnailHost x:Name="Thumbnail" />

                        <!-- Badge état -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                Style="{DynamicResource Badge}" Panel.ZIndex="10">
                            <TextBlock Text="{Binding StateLabel, Mode=OneWay}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Badge moniteur cible -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                Padding="8,3" CornerRadius="999"
                                BorderThickness="1"
                                Panel.ZIndex="10"
                                BorderBrush="{Binding MonitorBrush, Mode=OneWay}"
                                Background="{DynamicResource SurfaceBrush}"
                                Visibility="{Binding IsOnTargetMonitor, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="sur moniteur cible"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{Binding MonitorBrush, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Titre + meta -->
                <StackPanel Grid.Row="1" Margin="2,10,2,0">
                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                               FontSize="{DynamicResource FontSizeBody}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ProcessName, Mode=OneWay}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Border Grid.Column="1"
                                Padding="8,3" CornerRadius="999"
                                BorderThickness="1"
                                BorderBrush="{Binding MonitorBrush, Mode=OneWay}"
                                Background="Transparent">
                            <TextBlock Text="{Binding MonitorLabel, Mode=OneWay}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{Binding MonitorBrush, Mode=OneWay}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="WindowGrabber.Views.WindowCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:WindowGrabber.Controls"
             xmlns:conv="clr-namespace:WindowGrabber.Converters"
             mc:Ignorable="d"
             d:DesignWidth="280" d:DesignHeight="200">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:IsOnTargetToBrushConverter x:Key="TargetToBrush" />
    </UserControl.Resources>

    <!-- Un seul Style : celui de la ressource, avec Trigger de hover -->
    <Border x:Name="Root"
            Cursor="Hand"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{Binding IsOnTargetMonitor, Mode=OneWay, Converter={StaticResource TargetToBrush}}"
            BorderThickness="1"
            MouseLeftButtonUp="Root_OnMouseLeftButtonUp">
        <Border.RenderTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5" />
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Zone miniature : fallback TOUJOURS visible ; si DWM réussit, il peint par-dessus -->
            <Border Grid.Row="0"
                    Background="#FF0E131B"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="110"
                    ClipToBounds="True">
                <Grid>
                    <!-- Fallback icône (couche inférieure, toujours présent) -->
                    <Grid x:Name="Fallback">
                        <Image Source="{Binding Icon, Mode=OneWay}"
                               Width="56" Height="56"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="■"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="36"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding Icon, Mode=OneWay, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    </Grid>

                    <!-- DWM live thumbnail : couche supérieure, réserve l'espace et DWM peint à ces coordonnées -->
                    <ctrl:DwmThumbnailHost x:Name="Thumbnail" />

                    <!-- Badges par-dessus tout -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="6"
                            Style="{StaticResource Badge}"
                            Panel.ZIndex="10">
                        <TextBlock Text="{Binding StateLabel, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="6"
                            Style="{StaticResource BadgeAccent}"
                            Panel.ZIndex="10"
                            Visibility="{Binding IsOnTargetMonitor, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="sur moniteur cible"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Titre + meta -->
            <StackPanel Grid.Row="1" Margin="2,10,2,0">
                <TextBlock Text="{Binding Title, Mode=OneWay}"
                           FontSize="{StaticResource FontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ProcessName, Mode=OneWay}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <Border Grid.Column="1" Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding MonitorLabel, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
